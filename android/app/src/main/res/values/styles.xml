<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- LaunchTheme - MUST inherit from AppCompat for Stripe -->
    <style name="LaunchTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <!-- NormalTheme - App theme (MaterialComponents compatible) -->
    <style name="NormalTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">?android:colorBackground</item>
        <item name="colorPrimary">#6366F1</item>
        <item name="colorPrimaryVariant">#4F46E5</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#F43F5E</item>
        <item name="colorOnSecondary">#FFFFFF</item>
    </style>

</resources>
